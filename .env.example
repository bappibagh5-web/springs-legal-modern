# Copy to .env and fill in. Values come from Lovable Cloud (Project settings > Supabase).
# Never commit .env.

# Supabase project (public values, also used by the browser)
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server only. Needed for the contact/consultation forms and the admin area
# (lead inserts and admin queries use the service role). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: AI blog automation in the admin area
LOVABLE_API_KEY=""

# Local only: load Lovable-hosted images (/__l5e/...) from the live site
LOVABLE_PREVIEW_HOST="shimonkohn.com"
